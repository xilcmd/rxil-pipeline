      "sfx_overrides": null
    },
    {
      "seq": 10,
      "type": "dialogue",
      "section": "cold-open",
      "scene": "scene-1",
      "speaker": "host",
      "direction": "picking up phone",
      "text": "We have our first caller of the night. You're on the air.",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 11,
      "type": "dialogue",
      "section": "cold-open",
      "scene": "scene-1",
      "speaker": "caller",
      "direction": "distorted, nervous",
      "text": "Hi... I wasn't sure I should call, but I saw something last night that I can't explain.",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 12,
      "type": "dialogue",
      "section": "cold-open",
      "scene": "scene-1",
      "speaker": "host",
      "direction": null,
      "text": "Take your time. Tell us what happened.",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 13,
      "type": "dialogue",
      "section": "cold-open",
      "scene": "scene-1",
      "speaker": "caller",
      "direction": null,
      "text": "I was driving home on Route 9 when the radio cut out. Just static. And then... a voice. Not from any station.",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 14,
      "type": "direction",
      "section": "cold-open",
      "scene": "scene-1",
      "speaker": null,
      "direction": null,
      "text": "BEAT",
      "direction_type": "BEAT",
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 15,
      "type": "dialogue",
      "section": "cold-open",
      "scene": "scene-1",
      "speaker": "host",
      "direction": null,
      "text": "What did the voice say?",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 16,
      "type": "dialogue",
      "section": "cold-open",
      "scene": "scene-1",
      "speaker": "caller",
      "direction": null,
      "text": "It said my name. And then it said... \"Don't go home.\"",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 17,
      "type": "direction",
      "section": "cold-open",
      "scene": "scene-1",
      "speaker": null,
      "direction": null,
      "text": "BEAT — 3 SECONDS",
      "direction_type": "BEAT",
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 18,
      "type": "section_header",
      "section": "act1",
      "scene": null,
      "speaker": null,
      "direction": null,
      "text": "ACT ONE",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
