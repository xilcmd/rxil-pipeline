      "scene": "scene-2",
      "speaker": null,
      "direction": null,
      "text": "SCENE 2: THE INTERVIEW",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 20,
      "type": "direction",
      "section": "act1",
      "scene": "scene-2",
      "speaker": null,
      "direction": null,
      "text": "AMBIENCE: Same studio, quieter now",
      "direction_type": "AMBIENCE",
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 21,
      "type": "dialogue",
      "section": "act1",
      "scene": "scene-2",
      "speaker": "host",
      "direction": null,
      "text": "Joining us in the studio tonight is Dr. Alex Reeves. Doctor, you've studied phenomena like this before.",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 22,
      "type": "dialogue",
      "section": "act1",
      "scene": "scene-2",
      "speaker": "guest",
      "direction": null,
      "text": "That's right. What your caller described is consistent with a pattern we've documented across several counties.",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 23,
      "type": "dialogue",
      "section": "act1",
      "scene": "scene-2",
      "speaker": "host",
      "direction": null,
      "text": "A pattern?",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 24,
      "type": "dialogue",
      "section": "act1",
      "scene": "scene-2",
      "speaker": "guest",
      "direction": "leaning in",
      "text": "Electromagnetic interference followed by anomalous audio. We've recorded over thirty incidents in the past year alone.",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 25,
      "type": "direction",
      "section": "act1",
      "scene": "scene-2",
      "speaker": null,
      "direction": null,
      "text": "SFX: Paper rustling",
      "direction_type": "SFX",
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 26,
      "type": "dialogue",
      "section": "act1",
      "scene": "scene-2",
      "speaker": "guest",
      "direction": null,
      "text": "I brought some of the recordings with me, if you'd like to hear them.",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 27,
      "type": "dialogue",
