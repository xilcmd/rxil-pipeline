      "sfx_overrides": null
    },
    {
      "seq": 17,
      "type": "dialogue",
      "section": "act2",
      "scene": "scene-6",
      "speaker": "maya",
      "direction": "leaning in",
      "text": "Meaning the cost of training came down enough that hoarding the weights stopped making sense? DARIUS Exactly. And once LLaMA was out — even the way it got out — you had thousands of people fine-tuning it within weeks. That's not something OpenAI can replicate internally.",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
      "seq": 18,
      "type": "direction",
      "section": "act2",
      "scene": "scene-6",
      "speaker": null,
      "direction": null,
      "text": "SFX: Coffee mug set down on desk",
