      "scene": "scene-6",
      "speaker": "maya",
      "direction": null,
      "text": "So when Meta dropped LLaMA, that was kind of a watershed moment, right? Nobody really saw it coming.",
      "direction_type": null,
      "sfx_source": null,
      "sfx_overrides": null
    },
    {
